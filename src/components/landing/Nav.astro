---
const links = [
  { href: "#agenda", label: "Agenda" },
  { href: "#modalidades", label: "Modalidades" },
  { href: "#como-funciona", label: "Cómo funciona" },
  { href: "#planes", label: "Planes" },
  { href: "#preguntas", label: "Preguntas" },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-300 data-[solid=true]:border-line data-[solid=true]:bg-ink"
>
  <nav class="mx-auto flex h-16 max-w-[1400px] items-center justify-between gap-6 px-4 md:h-[72px] md:px-8" aria-label="Principal">
    <a href="/" class="display text-[28px] leading-none text-bone md:text-[32px]" aria-label="Blado, inicio">
      Blado<span class="text-lime">.</span>
    </a>
    <ul class="hidden items-center gap-8 text-sm text-mute-2 lg:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="transition-colors hover:text-bone">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-3">
      <a href="/login" class="rounded-full border border-line px-4 py-2.5 text-sm font-semibold text-bone transition-colors hover:border-lime hover:text-lime">Iniciar sesión</a>
      <a href="#contacto" class="btn btn-lime !px-4 !py-3 text-sm">Agenda tu valoración</a>
    </div>
  </nav>
</header>

<script>
  // Solid nav once the hero leaves the viewport (IntersectionObserver, no scroll listener).
  const nav = document.getElementById("site-nav");
  const sentinel = document.getElementById("hero-sentinel");
  if (nav && sentinel) {
    new IntersectionObserver(([entry]) => {
      nav.dataset.solid = String(!entry?.isIntersecting);
    }).observe(sentinel);
  }
</script>
