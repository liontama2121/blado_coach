---
import DigitRoll from "@/components/DigitRoll.astro";
import Icon from "@/components/Icon.astro";
import GoalStamp from "@/components/GoalStamp.astro";
import personSvg from "@tabler/icons/filled/man.svg?raw";
import { sampleProgress as s } from "@/content/landing";
import { round, seriesDeltas, trend, waistHeightRatio, WAIST_HEIGHT_REFERENCE } from "@/lib/metrics";

const fmt = (n: number, d = 1) => new Intl.NumberFormat("es-CO", { minimumFractionDigits: d, maximumFractionDigits: d }).format(n);

const weight = seriesDeltas(s.weightKg);
const waist = seriesDeltas(s.waistCm);
const waistTrend = trend(waist.vsFirst, 0.5);
const ica = waistHeightRatio(waist.current, s.heightCm)!;

// Weight chart, drawn to scale in a fixed viewBox.
const W = 560, H = 220, PAD = { l: 8, r: 8, t: 24, b: 28 };
const min = Math.floor(Math.min(...s.weightKg) - 1);
const max = Math.ceil(Math.max(...s.weightKg) + 1);
const x = (i: number) => PAD.l + (i * (W - PAD.l - PAD.r)) / (s.weightKg.length - 1);
const y = (v: number) => PAD.t + ((max - v) * (H - PAD.t - PAD.b)) / (max - min);
const pts = s.weightKg.map((v, i) => `${x(i)},${y(v)}`).join(" ");
const area = `M${x(0)},${H - PAD.b} L${pts.replaceAll(" ", " L")} L${x(s.weightKg.length - 1)},${H - PAD.b} Z`;
const last = s.weightKg.length - 1;
const person = personSvg.replace(/class="[^"]*"/, 'aria-hidden="true" focusable="false"');
---

<section id="seguimiento" class="bg-ink py-24 md:py-32" aria-labelledby="seg-title">
  <div class="mx-auto max-w-[1400px] px-4 md:px-8">
    <div class="grid gap-6 md:max-w-[62ch]">
      <h2 id="seg-title" class="display text-[clamp(3rem,7vw,6rem)] text-bone">Cada mes, <span class="text-lime">tus números.</span></h2>
      <p class="text-lg leading-relaxed text-mute-2">
        En tu app ves medidas, porcentaje de grasa, pruebas físicas y fotos de progreso, mes a mes. Así es como se ve un proceso.
      </p>
    </div>

    <div class="mt-14 grid gap-px bg-line md:grid-cols-6" role="group" aria-label="Ejemplo de seguimiento con datos ficticios">
      <!-- Weight chart -->
      <figure class="grid gap-4 bg-graphite p-6 md:col-span-4 md:p-8">
        <figcaption class="flex flex-wrap items-baseline justify-between gap-2">
          <span class="text-sm text-mute-2">Peso, kg</span>
          <span class="tnum text-sm text-bone">
            Hoy {fmt(s.weightKg[last]!)} kg <span class="text-lime">({fmt(weight.vsFirst!.abs)} desde la valoración)</span>
          </span>
        </figcaption>
        <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label={`Peso de ${fmt(s.weightKg[0]!)} a ${fmt(s.weightKg[last]!)} kilogramos en ${s.months.length} meses`}>
          <defs>
            <linearGradient id="wfill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="#c8ff1a" stop-opacity="0.22"></stop>
              <stop offset="1" stop-color="#c8ff1a" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          {[0.25, 0.5, 0.75].map((f) => <line x1={PAD.l} x2={W - PAD.r} y1={PAD.t + f * (H - PAD.t - PAD.b)} y2={PAD.t + f * (H - PAD.t - PAD.b)} stroke="#262a26" stroke-width="1" />)}
          <path d={area} fill="url(#wfill)"></path>
          <polyline points={pts} fill="none" stroke="#c8ff1a" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"></polyline>
          {s.weightKg.map((v, i) => <circle cx={x(i)} cy={y(v)} r={i === last ? 6 : 3.5} fill={i === last ? "#c8ff1a" : "#0d0e0d"} stroke="#c8ff1a" stroke-width="2" />)}
        </svg>
        <ol class="flex justify-between font-mono text-xs text-mute-2" aria-hidden="true">
          {s.months.map((m) => <li class="tnum">{m}</li>)}
        </ol>
      </figure>

      <!-- Waist -->
      <div class="grid content-between gap-6 bg-graphite p-6 md:col-span-2 md:p-8">
        <span class="text-sm text-mute-2">Cintura</span>
        <div>
          <p class="display text-[clamp(4.5rem,9vw,7rem)] leading-none text-lime">
            <DigitRoll value={fmt(waist.vsFirst!.abs)} /><span class="ml-2 text-[0.4em] text-bone">cm</span>
          </p>
          <p class="mt-3 text-sm text-mute-2">desde la valoración inicial</p>
        </div>
        <div class="flex items-end justify-between gap-4">
          <span class="w-fit border border-lime/40 px-2.5 py-1 font-mono text-xs uppercase text-lime">{waistTrend.replace("_", " ")}</span>
          <GoalStamp week={8} of={12} />
        </div>
      </div>

      <!-- ICA -->
      <div class="grid content-between gap-6 bg-graphite p-6 md:col-span-3 md:p-8">
        <span class="text-sm text-mute-2">Índice cintura-altura</span>
        <p class="display tnum text-[clamp(4rem,8vw,6rem)] leading-none text-bone">
          <DigitRoll value={fmt(round(ica, 2), 2)} />
        </p>
        <p class="max-w-[44ch] text-sm leading-relaxed text-mute-2">
          Referencia general: menos de {fmt(WAIST_HEIGHT_REFERENCE, 1)}. Es información orientativa, no un diagnóstico.
        </p>
      </div>

      <!-- Photos -->
      <div class="grid content-between gap-6 bg-lime p-6 text-ink md:col-span-3 md:p-8">
        <div class="flex items-start justify-between gap-6">
          <Icon name="lock" size={28} />
          <!-- Overprint: two months printed on top of each other; the change shows where they don't coincide. -->
          <figure class="overprint" aria-label="Ilustración del comparador: dos meses superpuestos">
            <span class="ink-a" set:html={person} />
            <span class="ink-b" set:html={person} />
            <figcaption class="flex justify-between font-mono text-[11px] uppercase">
              <span class="text-[#b0186d]">Jun</span><span>Sep</span>
            </figcaption>
          </figure>
        </div>
        <div class="grid gap-3">
          <h3 class="display text-[clamp(2.6rem,5vw,4rem)]">Fotos de progreso privadas</h3>
          <p class="max-w-[46ch] leading-relaxed text-ink/75">
            Frontal, lateral y posterior cada mes, con comparador antes y después. Solo tú y tu coach las ven, y las borras cuando quieras.
          </p>
        </div>
      </div>
    </div>
    <p class="mt-4 font-mono text-xs text-mute-2">Datos de ejemplo. No corresponden a una persona real.</p>
  </div>
</section>

<style>
  .overprint {
    position: relative;
    display: grid;
    width: 112px;
    gap: 4px;
  }
  .overprint > span {
    grid-area: 1 / 1;
    display: block;
    height: 120px;
    mix-blend-mode: multiply;
  }
  .overprint :global(svg) {
    width: 100%;
    height: 100%;
  }
  /* June: fluo magenta, wider. September: ink, narrower. Overlap prints darker. */
  .ink-a {
    color: #ff3ea5;
    transform: scaleX(1.12) translateX(-3px);
  }
  .ink-b {
    color: rgba(13, 14, 13, 0.82);
    transform: translateX(3px);
  }
  .overprint figcaption {
    grid-area: 2 / 1;
  }
</style>
