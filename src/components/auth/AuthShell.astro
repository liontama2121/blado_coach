---
/**
 * Split auth screen: Bladimir on one side reacting to the form, the form on the other.
 * Any password field with [data-pw] makes him cover his eyes; the [data-pw-toggle]
 * button reveals the text and he peeks with one eye. Email fields with [data-watch]
 * make him follow the text as it is typed.
 */
import "@fontsource-variable/league-gothic/wdth";
import Base from "@/layouts/Base.astro";
import Bladimir from "@/components/mascota/Bladimir.astro";

interface Props {
  title: string;
  heading: string;
  bubble: string;
}
const { title, heading, bubble } = Astro.props;
---

<Base title={title} noindex>
  <main class="auth">
    <a href="/" class="auth-logo">Blado</a>
    <section class="auth-mascot" aria-hidden="false">
      <div class="auth-bubble" data-auth-bubble aria-live="polite">{bubble}</div>
      <Bladimir state="wave" size="min(380px, 62vw)" class="auth-face" label="Bladimir, tu coach" />
    </section>
    <section class="auth-panel">
      <h1 class="auth-h1">{heading}</h1>
      <slot />
    </section>
  </main>
</Base>

<style is:global>
  .auth {
    --lime: #c6ff00;
    --bg: #0d0d0d;
    --panel: #141513;
    --fg: #f1f1ec;
    --mute: #a3a59e;
    --line: #2a2d2a;
    --err: #ff7a5c;
    --bl-bg: var(--bg);
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--bg);
    color: var(--fg);
  }
  @media (max-width: 860px) {
    .auth {
      grid-template-columns: 1fr;
      align-content: start;
    }
  }
  .auth-logo {
    position: absolute;
    top: 20px;
    left: clamp(16px, 4vw, 48px);
    font: 400 34px/1 "League Gothic Variable", sans-serif;
    font-variation-settings: "wdth" 75;
    text-transform: uppercase;
    color: var(--lime);
    text-decoration: none;
    z-index: 2;
  }
  .auth-mascot {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 18px;
    padding: 80px 24px 24px;
    border-right: 1px solid var(--line);
  }
  @media (max-width: 860px) {
    .auth-mascot {
      border-right: 0;
      padding: 72px 16px 0;
    }
    .auth-face {
      --bl-size: min(220px, 56vw) !important;
    }
  }
  .auth-bubble {
    max-width: 320px;
    padding: 12px 16px;
    border: 1px solid var(--lime);
    border-radius: 18px 18px 18px 4px;
    font: 500 15px/1.4 var(--font-sans);
    text-align: center;
  }
  .auth-panel {
    display: grid;
    align-content: center;
    gap: 28px;
    padding: 48px clamp(16px, 6vw, 96px);
    max-width: 560px;
    width: 100%;
  }
  @media (max-width: 860px) {
    .auth-panel {
      padding-top: 24px;
      margin-inline: auto;
    }
  }
  .auth-h1 {
    margin: 0;
    font: 400 clamp(3.4rem, 7vw, 5.6rem) / 0.86 "League Gothic Variable", sans-serif;
    font-variation-settings: "wdth" 75;
    text-transform: uppercase;
  }
  .auth-form {
    display: grid;
    gap: 20px;
  }
  .auth-field {
    display: grid;
    gap: 8px;
  }
  .auth-field label {
    font-size: 14px;
    font-weight: 500;
  }
  .auth-input-wrap {
    position: relative;
  }
  .auth-input {
    width: 100%;
    height: 54px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
    color: var(--fg);
    font: 500 16px/1 var(--font-sans);
    caret-color: var(--lime);
    transition: border-color 0.2s;
  }
  .auth-input::placeholder {
    color: #8b8e87;
  }
  .auth-input:focus {
    outline: none;
    border-color: var(--lime);
  }
  .auth-input[aria-invalid="true"] {
    border-color: var(--err);
  }
  .auth-input-wrap .auth-input {
    padding-right: 56px;
  }
  .auth-eye {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--mute);
    cursor: pointer;
  }
  .auth-eye:hover,
  .auth-eye[aria-pressed="true"] {
    color: var(--lime);
  }
  .auth-eye .when-on,
  .auth-eye[aria-pressed="true"] .when-off {
    display: none;
  }
  .auth-eye[aria-pressed="true"] .when-on {
    display: block;
  }
  .auth-err {
    min-height: 1.2em;
    margin: 0;
    color: var(--err);
    font-size: 14px;
  }
  .auth-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 56px;
    border: 0;
    border-radius: 999px;
    background: var(--lime);
    color: #0d0d0d;
    font: 600 16px/1 var(--font-sans);
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .auth-btn:hover {
    transform: translateY(-1px);
  }
  .auth-btn:active {
    transform: scale(0.98);
  }
  .auth-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .auth :focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 3px;
  }
  .auth-note {
    margin: 0;
    color: var(--mute);
    font-size: 14px;
  }
  .auth-note a {
    color: var(--fg);
  }
</style>

<script>
  // Bladimir reacts to the form.
  const face = document.querySelector<HTMLElement>(".auth-face");
  const bubble = document.querySelector<HTMLElement>("[data-auth-bubble]");
  const set = (state: string, text?: string) => {
    face?.dispatchEvent(new CustomEvent("bladimir:state", { detail: state }));
    if (text && bubble) bubble.textContent = text;
  };
  const look = (x: number) => face?.dispatchEvent(new CustomEvent("bladimir:look", { detail: x }));

  const pwFields = [...document.querySelectorAll<HTMLInputElement>("[data-pw]")];
  const toggles = [...document.querySelectorAll<HTMLButtonElement>("[data-pw-toggle]")];
  let revealed = false;

  document.querySelectorAll<HTMLInputElement>("[data-watch]").forEach((input) => {
    const follow = () => look(Math.min(input.value.length, 28) / 14 - 1);
    input.addEventListener("focus", () => {
      set("watch", "Te estoy mirando escribir el correo...");
      setTimeout(follow, 50);
    });
    input.addEventListener("input", follow);
  });

  pwFields.forEach((input) => {
    input.addEventListener("focus", () =>
      revealed ? set("peek", "Bueno... solo con un ojito.") : set("cover", "Tranquilo/a, no estoy mirando tu contraseña."),
    );
  });

  toggles.forEach((btn) =>
    btn.addEventListener("click", () => {
      revealed = !revealed;
      pwFields.forEach((f) => (f.type = revealed ? "text" : "password"));
      toggles.forEach((t) => {
        t.setAttribute("aria-pressed", String(revealed));
        t.setAttribute("aria-label", revealed ? "Ocultar contraseña" : "Mostrar contraseña");
      });
      const focusedPw = pwFields.some((f) => f === document.activeElement) || pwFields.length > 0;
      if (focusedPw) set(revealed ? "peek" : "cover", revealed ? "Bueno... solo con un ojito." : "Listo, ojos tapados.");
      pwFields[0]?.focus();
    }),
  );

  // Leaving the form fields: back to a friendly idle.
  document.querySelector(".auth-form")?.addEventListener("focusout", (e) => {
    const to = (e as FocusEvent).relatedTarget as HTMLElement | null;
    if (!to || !to.closest(".auth-form")) set("idle");
  });

  // Expose for the page scripts (success / error reactions).
  (window as unknown as { bladimirSay: typeof set }).bladimirSay = set;
</script>
