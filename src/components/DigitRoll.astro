---
/**
 * Number set in fixed digit slots. At rest it shows the final value
 * (works without JS and under reduced motion). When it enters the
 * viewport, each digit rolls into place, one after another.
 */
interface Props {
  value: string; // already formatted, e.g. "-4,2"
  class?: string;
}
const { value, class: className = "" } = Astro.props;
const chars = [...value];
---

<span class:list={["digit-roll tnum inline-flex", className]} role="img" aria-label={value}>
  {
    chars.map((ch, i) =>
      /\d/.test(ch) ? (
        <span class="slot" aria-hidden="true" style={`--d:${ch};--i:${i}`}>
          <span class="strip">
            {Array.from({ length: 10 }, (_, n) => (
              <span>{n}</span>
            ))}
          </span>
        </span>
      ) : (
        <span aria-hidden="true">{ch}</span>
      ),
    )
  }
</span>

<style>
  .slot {
    display: inline-block;
    height: 1em;
    overflow: hidden;
    line-height: 1;
  }
  .strip {
    display: flex;
    flex-direction: column;
    transform: translateY(calc(var(--d) * -1em));
  }
  .strip > span {
    height: 1em;
    line-height: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.digit-roll.armed) .strip {
      transform: translateY(0);
    }
    :global(.digit-roll.rolling) .strip {
      transform: translateY(calc(var(--d) * -1em));
      transition: transform 1.1s var(--ease-out-expo);
      transition-delay: calc(var(--i) * 90ms);
    }
  }
</style>

<script>
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const rolls = document.querySelectorAll<HTMLElement>(".digit-roll");
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          requestAnimationFrame(() => el.classList.add("rolling"));
          io.unobserve(el);
        }
      },
      { threshold: 0.6 },
    );
    rolls.forEach((el) => {
      // Arm only elements still below the fold, so nothing visible flickers to 0.
      if (el.getBoundingClientRect().top > innerHeight) {
        el.classList.add("armed");
        io.observe(el);
      }
    });
  }
</script>
