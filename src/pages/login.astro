---
export const prerender = false;
import AuthShell from "@/components/auth/AuthShell.astro";
import Icon from "@/components/Icon.astro";
import { homeFor } from "@/lib/auth/session";

// Already signed in: go home.
const user = Astro.locals.user;
if (user) return Astro.redirect(user.mustChangePassword ? "/cambiar-clave" : homeFor(user.role));

const next = Astro.url.searchParams.get("next") ?? "";
const loggedOut = Astro.url.searchParams.has("salida");
const failed = Astro.url.searchParams.has("error");
---

<AuthShell
  title="Iniciar sesión · Blado"
  heading="Iniciar sesión"
  bubble={loggedOut ? "¡Nos vemos pronto! Aquí te espero." : "¡Hola! Qué bueno verte. Entra a tu cuenta."}
>
  <form class="auth-form" id="login-form" action="/api/auth/login" method="post" novalidate>
    <input type="hidden" name="next" value={next} />
    <div class="auth-field">
      <label for="email">Correo</label>
      <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required class="auth-input" placeholder="tu@correo.com" data-watch aria-describedby="err-email" />
      <p class="auth-err" id="err-email" data-err="email"></p>
    </div>
    <div class="auth-field">
      <label for="password">Contraseña</label>
      <div class="auth-input-wrap">
        <input id="password" name="password" type="password" autocomplete="current-password" required class="auth-input" data-pw aria-describedby="err-password" />
        <button type="button" class="auth-eye" data-pw-toggle aria-pressed="false" aria-label="Mostrar contraseña" aria-controls="password">
          <span class="when-off"><Icon name="eye" size={22} /></span>
          <span class="when-on"><Icon name="eyeOff" size={22} /></span>
        </button>
      </div>
      <p class="auth-err" id="err-password" data-err="password"></p>
    </div>
    <p class="auth-err" data-err="form" role="alert">{failed ? "Correo o contraseña incorrectos." : ""}</p>
    <button type="submit" class="auth-btn"><Icon name="login" size={20} /> <span data-label>Iniciar sesión</span></button>
  </form>
  <p class="auth-note">¿Aún no eres estudiante? <a href="/#contacto">Agenda tu valoración</a> y el coach crea tu cuenta.</p>
</AuthShell>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement;
  const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const label = btn.querySelector<HTMLElement>("[data-label]")!;
  const say = (s: string, t?: string) => (window as unknown as { bladimirSay?: (s: string, t?: string) => void }).bladimirSay?.(s, t);

  const showErrors = (errors: Record<string, string>) => {
    form.querySelectorAll<HTMLElement>("[data-err]").forEach((el) => {
      const k = el.dataset.err!;
      el.textContent = errors[k] ?? "";
      form.querySelector(`[name="${k}"]`)?.setAttribute("aria-invalid", String(Boolean(errors[k])));
    });
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.disabled = true;
    label.textContent = "Entrando…";
    say("think", "Déjame revisar...");
    try {
      const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { accept: "application/json" } });
      const data = (await res.json()) as { ok: boolean; redirect?: string; errors?: Record<string, string> };
      if (data.ok) {
        showErrors({});
        say("celebrate", "¡Adentro! Vamos con toda.");
        setTimeout(() => location.assign(data.redirect ?? "/app"), 900);
        return;
      }
      showErrors(data.errors ?? { form: "No pudimos iniciar sesión." });
      say("sad-soft", "Algo no cuadró. Revisa y lo intentamos de nuevo.");
    } catch {
      showErrors({ form: "Sin conexión. Revisa tu internet." });
      say("sad-soft", "Parece que no hay conexión.");
    }
    btn.disabled = false;
    label.textContent = "Iniciar sesión";
  });
</script>
