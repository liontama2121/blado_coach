---
// Meal plan editor: targets (with Mifflin suggestion), meals per slot and day type, safe food search, live totals, publish.
export const prerender = false;
import { env } from "cloudflare:workers";
import CoachShell from "@/layouts/CoachShell.astro";
import Bladimir from "@/components/mascota/Bladimir.astro";
import Icon from "@/components/Icon.astro";
import { ageOn } from "@/lib/metrics";
import { suggestTargets, type Goal } from "@/lib/nutrition";
import { bogotaParts } from "@/lib/schedule";
import { recipeAsResult, type SearchResult } from "@/lib/server/foods";
import { getRestrictions, getTargets, SLOT_LABEL } from "@/lib/server/plans";

const id = Astro.params.id!;
const db = env.DB;
const s = await db.prepare(`SELECT id, full_name, sex, height_cm, birth_date, goal_type FROM students WHERE id = ?1`).bind(id).first<{ id: string; full_name: string; sex: "M" | "F"; height_cm: number; birth_date: string; goal_type: string }>();
if (!s) return Astro.redirect("/coach/estudiantes");

const [targets, restrictions, lastW, draft, published, needsNutri] = await Promise.all([
  getTargets(db, id),
  getRestrictions(db, id),
  db.prepare(`SELECT weight_kg FROM measurements WHERE student_id = ?1 ORDER BY measured_on DESC LIMIT 1`).bind(id).first<{ weight_kg: number }>(),
  db.prepare(`SELECT id, version, kind, change_reason FROM meal_plans WHERE student_id = ?1 AND status = 'borrador' ORDER BY version DESC LIMIT 1`).bind(id).first<{ id: string; version: number; kind: string; change_reason: string | null }>(),
  db.prepare(`SELECT id, version, kind FROM meal_plans WHERE student_id = ?1 AND status IN ('publicado','aprobado') ORDER BY version DESC LIMIT 1`).bind(id).first<{ id: string; version: number; kind: string }>(),
  db.prepare(`SELECT COUNT(*) AS n FROM dietary_restrictions WHERE student_id = ?1 AND requires_nutritionist = 1`).bind(id).first<{ n: number }>(),
]);
const source = draft ?? published;

// Load the plan being edited with per-100 g data for live totals.
type Item = SearchResult & { grams: number; household_measure: string };
type Meal = { slot: string; day_type: string; items: Item[] };
let meals: Meal[] = [];
if (source) {
  const [ms, its] = await Promise.all([
    db.prepare(`SELECT id, slot, day_type FROM meal_plan_meals WHERE plan_id = ?1 ORDER BY position`).bind(source.id).all<{ id: string; slot: string; day_type: string }>(),
    db
      .prepare(
        `SELECT i.meal_id, i.grams, i.household_measure, i.food_id, i.recipe_id, f.name, f.ref_grams, f.household_measure AS f_measure, f.food_group AS "group",
                f.kcal, f.protein_g, f.carbs_g, f.fat_g, f.fiber_g, r.name AS r_name
           FROM meal_plan_items i JOIN meal_plan_meals m ON m.id = i.meal_id LEFT JOIN foods f ON f.id = i.food_id LEFT JOIN recipes r ON r.id = i.recipe_id
          WHERE m.plan_id = ?1`,
      )
      .bind(source.id)
      .all<Record<string, any>>(),
  ]);
  const recipeCache = new Map<string, SearchResult>();
  for (const it of its.results) if (it.recipe_id && !recipeCache.has(it.recipe_id)) recipeCache.set(it.recipe_id, await recipeAsResult(db, it.recipe_id, it.r_name));
  meals = ms.results.map((m) => ({
    slot: m.slot,
    day_type: m.day_type,
    items: its.results
      .filter((i) => i.meal_id === m.id)
      .map((i) =>
        i.recipe_id
          ? { ...recipeCache.get(i.recipe_id)!, grams: i.grams, household_measure: i.household_measure ?? "1 porción" }
          : { kind: "food" as const, id: i.food_id, name: i.name, ref_grams: i.ref_grams, household_measure: i.household_measure ?? i.f_measure, group: i.group, kcal: i.kcal, protein_g: i.protein_g, carbs_g: i.carbs_g, fat_g: i.fat_g, fiber_g: i.fiber_g, grams: i.grams },
      ),
  }));
}

const age = ageOn(s.birth_date, bogotaParts(new Date()).date) ?? 30;
const goal: Goal = s.goal_type === "perder_grasa" ? "perder_grasa" : s.goal_type === "ganar_musculo" ? "ganar_musculo" : "mantener";
const suggestion = lastW ? suggestTargets({ sex: s.sex, weightKg: lastW.weight_kg, heightCm: s.height_cm, age, activity: "moderado", goal }) : null;
const TAGS: Record<string, string> = { sin_lactosa: "Sin lactosa", sin_lacteos: "Sin lácteos", vegano: "Vegano", vegetariano: "Vegetariano", celiaquia: "Celiaquía", sin_cerdo: "Sin cerdo", pescetariano: "Pescetariano", sin_res: "Sin res", sin_picante: "Sin picante" };
const chip = (x: (typeof restrictions)[number]) =>
  x.type === "alergia" ? `Alergia ${x.severity}: ${x.allergen_label}` : x.type === "no_le_gusta" ? `No le gusta: ${x.food_name}` : (TAGS[x.restriction_tag ?? ""] ?? x.restriction_tag ?? x.type);
const init = { meals, kind: source?.kind ?? "guia" };
---

<CoachShell title={`Alimentación · ${s.full_name}`} section="estudiantes">
  <a href={`/coach/estudiantes/${id}?tab=alimentacion`} class="c-muted text-sm" style="text-decoration:none">← {s.full_name}</a>
  <div class="c-row">
    <h1 class="c-h1">Plan de alimentación</h1>
    <span class="c-tag">{draft ? `Borrador v${draft.version}` : published ? `Publicado v${published.version} · al guardar se crea un borrador` : "Nuevo"}</span>
  </div>

  <section class="c-card head">
    <Bladimir state="cook" size={70} />
    <div class="grid gap-2">
      <div class="flex flex-wrap gap-2">
        {restrictions.length ? restrictions.map((r) => <span class:list={["c-tag", r.severity === "grave" ? "c-tag-err" : ""]}>{chip(r)}</span>) : <span class="c-muted text-sm">Sin restricciones registradas.</span>}
      </div>
      <p class="c-muted text-sm">El buscador solo muestra alimentos y recetas seguros para este estudiante. La base de datos vuelve a verificar al publicar.</p>
      {needsNutri?.n ? <p class="c-tag c-tag-warn" style="justify-self:start">Tiene una condición que requiere nutricionista: el plan no se podrá publicar sin su aprobación.</p> : null}
      {draft?.change_reason?.startsWith("Revalidación") && <p class="c-tag c-tag-err" style="justify-self:start">Este plan volvió a borrador por una nueva restricción. Corrígelo antes de publicar.</p>}
    </div>
  </section>

  <section class="c-card" aria-labelledby="t-t">
    <div class="c-row"><h2 id="t-t" class="c-h2">Objetivo diario</h2>
      {suggestion && <button type="button" class="c-btn c-btn-ghost" id="suggest" data-s={JSON.stringify(suggestion)}>Usar sugerencia ({suggestion.kcal} kcal)</button>}
    </div>
    {suggestion && <p class="c-muted text-xs">Sugerencia: Mifflin-St Jeor × actividad moderada ({suggestion.maintenance} kcal de mantenimiento), {suggestion.adjustPct}% {goal === "ganar_musculo" ? "de superávit" : goal === "perder_grasa" ? "de déficit" : ""}, proteína {goal === "perder_grasa" ? "2,0" : "1,8"} g/kg. Solo orientativo; tú decides.</p>}
    <form id="targets" class="tg" novalidate>
      <label class="c-field"><span>Energía (kcal)</span><input name="kcal" type="number" value={targets?.kcal ?? ""} /></label>
      <label class="c-field"><span>Proteína (g)</span><input name="protein_g" type="number" value={targets?.protein_g ?? ""} /></label>
      <label class="c-field"><span>Carbohidratos (g)</span><input name="carbs_g" type="number" value={targets?.carbs_g ?? ""} /></label>
      <label class="c-field"><span>Grasa (g)</span><input name="fat_g" type="number" value={targets?.fat_g ?? ""} /></label>
      <label class="c-field"><span>Fibra (g)</span><input name="fiber_g" type="number" value={targets?.fiber_g ?? ""} /></label>
      <label class="c-field"><span>Agua (L)</span><input name="water_l" type="number" step="0.1" value={targets?.water_l ?? ""} /></label>
      <label class="c-field"><span>Déficit (%)</span><input name="deficit_pct" type="number" step="1" value={suggestion?.adjustPct && goal === "perder_grasa" ? suggestion.adjustPct : ""} /></label>
      <label class="conf"><input type="checkbox" name="confirm_deficit" /> Confirmo un déficit mayor al 25 %</label>
      <button class="c-btn">Guardar objetivo</button>
    </form>
    <p class="c-err" id="t-err"></p>
  </section>

  <div class="daytype" role="group" aria-label="Ver día">
    <button type="button" data-dt="entreno" aria-pressed="true">Día de entreno</button>
    <button type="button" data-dt="descanso" aria-pressed="false">Día de descanso</button>
  </div>

  <section class="c-card totals" id="totals" aria-live="polite"></section>

  <div id="meals" class="grid gap-4"></div>

  <section class="c-card">
    <div class="c-grid-3 add-meal">
      <label class="c-field"><span>Agregar comida</span><select id="new-slot">{Object.entries(SLOT_LABEL).map(([k, l]) => <option value={k}>{l}</option>)}</select></label>
      <label class="c-field"><span>Aplica</span><select id="new-dt"><option value="todos">Todos los días</option><option value="entreno">Solo días de entreno</option><option value="descanso">Solo días de descanso</option></select></label>
      <button class="c-btn c-btn-ghost" type="button" id="add-meal"><Icon name="plus" size={16} /> Agregar comida</button>
    </div>
  </section>

  <section class="c-card save">
    <div class="c-grid-2">
      <label class="c-field"><span>Tipo</span><select id="kind"><option value="guia">Guía de alimentación (coach)</option><option value="plan">Plan (requiere nutricionista para aprobar)</option></select></label>
      <label class="c-field"><span>Motivo del cambio</span><input id="reason" placeholder="Ej: ajuste por meseta" /></label>
    </div>
    <ul id="conflicts" class="conf-list"></ul>
    <p class="c-err" id="err" role="alert"></p>
    <div class="c-row">
      <button class="c-btn c-btn-ghost" id="save">Guardar borrador</button>
      <button class="c-btn" id="publish"><Icon name="check" size={18} /> Guardar y publicar</button>
    </div>
  </section>

  <template id="init" set:html={JSON.stringify(init)} />
  <template id="tg" set:html={JSON.stringify(targets ?? null)} />
</CoachShell>

<style>
  .head {
    grid-template-columns: auto 1fr;
    align-items: center;
  }
  .tg {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 10px;
    align-items: end;
  }
  .tg .conf {
    grid-column: 1 / span 4;
  }
  @media (max-width: 1000px) {
    .tg {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tg .conf {
      grid-column: 1 / -1;
    }
  }
  .conf {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    color: var(--mute);
  }
  .conf input {
    accent-color: var(--lime);
  }
  .daytype {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .daytype button {
    min-height: 44px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--mute);
    font: 600 14px/1 var(--font-sans);
    cursor: pointer;
  }
  .daytype button[aria-pressed="true"] {
    border-color: var(--lime);
    color: var(--lime);
  }
  .totals {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  @media (max-width: 800px) {
    .totals {
      grid-template-columns: 1fr 1fr;
    }
  }
  :global(.tbar) {
    display: grid;
    gap: 6px;
    font-size: 13px;
  }
  :global(.tbar .track) {
    height: 8px;
    border-radius: 999px;
    background: var(--card2);
    overflow: hidden;
  }
  :global(.tbar .track i) {
    display: block;
    height: 100%;
    background: var(--lime);
  }
  :global(.tbar .track i.over) {
    background: var(--warn);
  }
  :global(.meal-card) {
    display: grid;
    gap: 10px;
  }
  :global(.meal-items) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  :global(.mi) {
    display: grid;
    grid-template-columns: minmax(160px, 2fr) 100px minmax(120px, 1.3fr) 120px auto;
    gap: 8px;
    align-items: center;
    padding: 8px 10px;
    border-radius: 12px;
    background: var(--card2);
    font-size: 14px;
  }
  :global(.mi input) {
    min-height: 38px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
    color: var(--fg);
    font: 500 14px/1 var(--font-sans);
    width: 100%;
  }
  :global(.mi .mac) {
    color: var(--mute);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  :global(.mi button) {
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  @media (max-width: 800px) {
    :global(.mi) {
      grid-template-columns: 1fr 90px auto;
    }
    :global(.mi .measure),
    :global(.mi .mac) {
      grid-column: 1 / -1;
    }
  }
  :global(.search) {
    position: relative;
  }
  :global(.search-results) {
    list-style: none;
    margin: 6px 0 0;
    padding: 6px;
    display: grid;
    gap: 2px;
    max-height: 280px;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
  }
  :global(.search-results button) {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--fg);
    text-align: left;
    cursor: pointer;
    font: 500 14px/1.2 var(--font-sans);
  }
  :global(.search-results button:hover) {
    background: var(--card2);
  }
  .add-meal {
    align-items: end;
  }
  .save {
    position: sticky;
    bottom: 12px;
    z-index: 10;
    border-color: var(--lime);
  }
  @media (max-width: 860px) {
    .save {
      bottom: 84px;
    }
  }
  .conf-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  :global(.conf-list li) {
    padding: 8px 12px;
    border-radius: 10px;
    background: rgba(255, 122, 92, 0.14);
    color: var(--err);
    font-size: 14px;
  }
</style>

<script>
  type R = { kind: "food" | "recipe"; id: string; name: string; ref_grams: number; household_measure: string; group: string; kcal: number; protein_g: number; carbs_g: number; fat_g: number; fiber_g: number };
  type Item = R & { grams: number };
  type Meal = { slot: string; day_type: string; items: Item[] };
  const SLOT: Record<string, string> = { desayuno: "Desayuno", media_manana: "Media mañana", pre_entreno: "Pre-entreno", almuerzo: "Almuerzo", post_entreno: "Post-entreno", onces: "Onces", cena: "Cena" };
  const DT: Record<string, string> = { todos: "Todos los días", entreno: "Días de entreno", descanso: "Días de descanso" };
  const ORDER = ["desayuno", "media_manana", "pre_entreno", "almuerzo", "post_entreno", "onces", "cena"];
  const studentId = location.pathname.split("/")[3]!;
  const state: { meals: Meal[]; kind: string } = JSON.parse(document.getElementById("init")!.innerHTML);
  let targets: { kcal: number; protein_g: number; carbs_g: number; fat_g: number } | null = JSON.parse(document.getElementById("tg")!.innerHTML);
  let view = "entreno";
  (document.getElementById("kind") as unknown as HTMLSelectElement).value = state.kind;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const mac = (i: Item) => {
    const f = i.grams / 100;
    return { kcal: i.kcal * f, p: i.protein_g * f, c: i.carbs_g * f, g: i.fat_g * f };
  };
  const r0 = (n: number) => Math.round(n);

  function totals() {
    const t = { kcal: 0, p: 0, c: 0, g: 0 };
    for (const m of state.meals.filter((m) => m.day_type === "todos" || m.day_type === view))
      for (const i of m.items) {
        const x = mac(i);
        t.kcal += x.kcal; t.p += x.p; t.c += x.c; t.g += x.g;
      }
    const bars = [
      ["Energía", t.kcal, targets?.kcal, "kcal"], ["Proteína", t.p, targets?.protein_g, "g"], ["Carbohidratos", t.c, targets?.carbs_g, "g"], ["Grasa", t.g, targets?.fat_g, "g"],
    ] as const;
    document.getElementById("totals")!.innerHTML = bars
      .map(([k, v, tg, u]) => {
        const pct = tg ? (v / tg) * 100 : 0;
        return `<div class="tbar"><div class="c-row"><span>${k}</span><span class="c-muted">${r0(v)}${tg ? ` / ${tg}` : ""} ${u}</span></div><div class="track"><i class="${pct > 110 ? "over" : ""}" style="width:${Math.min(100, pct)}%"></i></div></div>`;
      })
      .join("");
  }

  const mealsEl = document.getElementById("meals")!;
  function render() {
    state.meals.sort((a, b) => ORDER.indexOf(a.slot) - ORDER.indexOf(b.slot));
    mealsEl.innerHTML = state.meals
      .map((m, mi) => {
        const t = m.items.reduce((s, i) => s + mac(i).kcal, 0);
        const dim = m.day_type !== "todos" && m.day_type !== view;
        return `<section class="c-card meal-card" data-mi="${mi}" style="${dim ? "opacity:.5" : ""}">
          <div class="c-row"><h2 class="c-h2">${SLOT[m.slot]}</h2><span class="c-muted text-sm">${DT[m.day_type]} · ${r0(t)} kcal</span>
            <button type="button" class="c-btn c-btn-ghost" data-rm-meal style="min-height:34px">Quitar comida</button></div>
          <ul class="meal-items">${m.items
            .map(
              (i, ii) => `<li class="mi" data-ii="${ii}">
                <span><strong>${esc(i.name)}</strong>${i.kind === "recipe" ? ' <span class="c-tag">receta</span>' : ""}</span>
                <label><span class="sr-only">Gramos</span><input type="number" min="1" data-f="grams" value="${i.grams}" /></label>
                <label class="measure"><span class="sr-only">Medida casera</span><input data-f="household_measure" value="${esc(i.household_measure)}" /></label>
                <span class="mac">${r0(mac(i).kcal)} kcal · P ${r0(mac(i).p)} · C ${r0(mac(i).c)} · G ${r0(mac(i).g)}</span>
                <button type="button" data-rm aria-label="Quitar">×</button>
              </li>`,
            )
            .join("")}</ul>
          <div class="search"><input class="c-input" data-search placeholder="Buscar alimento o receta (ya filtrado por sus restricciones)" /><ul class="search-results" hidden></ul></div>
        </section>`;
      })
      .join("") || `<p class="c-muted">Agrega la primera comida abajo.</p>`;
    totals();
  }

  let timer: number | undefined;
  mealsEl.addEventListener("input", (e) => {
    const t = e.target as HTMLInputElement;
    const card = t.closest<HTMLElement>("[data-mi]");
    if (!card) return;
    const meal = state.meals[Number(card.dataset.mi)]!;
    if (t.hasAttribute("data-search")) {
      clearTimeout(timer);
      const list = card.querySelector<HTMLElement>(".search-results")!;
      timer = window.setTimeout(async () => {
        if (t.value.trim().length < 2) return void (list.hidden = true);
        const res = await fetch(`/api/coach/foods?student=${studentId}&q=${encodeURIComponent(t.value)}`).then((r) => r.json() as Promise<{ results: R[] }>);
        list.hidden = false;
        list.innerHTML = res.results.length
          ? res.results.map((r, k) => `<li><button type="button" data-pick="${k}">${esc(r.name)}<span class="c-muted">${r.kind === "recipe" ? "receta" : esc(r.household_measure)}</span></button></li>`).join("")
          : `<li class="c-muted" style="padding:10px">Sin resultados seguros para "${esc(t.value)}".</li>`;
        (list as unknown as { _r: R[] })._r = res.results;
      }, 220);
      return;
    }
    const row = t.closest<HTMLElement>("[data-ii]");
    if (!row) return;
    const item = meal.items[Number(row.dataset.ii)]!;
    if (t.dataset.f === "grams") item.grams = Number(t.value) || 0;
    else if (t.dataset.f === "household_measure") item.household_measure = t.value;
    const macEl = row.querySelector(".mac");
    if (macEl) macEl.textContent = `${r0(mac(item).kcal)} kcal · P ${r0(mac(item).p)} · C ${r0(mac(item).c)} · G ${r0(mac(item).g)}`;
    totals();
  });
  mealsEl.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button");
    const card = b?.closest<HTMLElement>("[data-mi]");
    if (!b || !card) return;
    const meal = state.meals[Number(card.dataset.mi)]!;
    if (b.dataset.pick !== undefined) {
      const r = (b.closest(".search-results") as unknown as { _r: R[] })._r[Number(b.dataset.pick)]!;
      meal.items.push({ ...r, grams: Math.round(r.ref_grams) });
    } else if (b.hasAttribute("data-rm")) meal.items.splice(Number(b.closest<HTMLElement>("[data-ii]")!.dataset.ii), 1);
    else if (b.hasAttribute("data-rm-meal")) state.meals.splice(Number(card.dataset.mi), 1);
    else return;
    render();
  });

  document.getElementById("add-meal")!.addEventListener("click", () => {
    const slot = (document.getElementById("new-slot") as unknown as HTMLSelectElement).value;
    const dt = (document.getElementById("new-dt") as unknown as HTMLSelectElement).value;
    state.meals.push({ slot, day_type: dt, items: [] });
    render();
  });
  document.querySelectorAll<HTMLButtonElement>("[data-dt]").forEach((b) =>
    b.addEventListener("click", () => {
      view = b.dataset.dt!;
      document.querySelectorAll("[data-dt]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      render();
    }),
  );

  // targets
  const tf = document.getElementById("targets") as unknown as HTMLFormElement;
  document.getElementById("suggest")?.addEventListener("click", (e) => {
    const s = JSON.parse((e.currentTarget as HTMLElement).dataset.s!);
    (tf.elements.namedItem("kcal") as HTMLInputElement).value = s.kcal;
    (tf.elements.namedItem("protein_g") as HTMLInputElement).value = s.protein;
    (tf.elements.namedItem("carbs_g") as HTMLInputElement).value = s.carbs;
    (tf.elements.namedItem("fat_g") as HTMLInputElement).value = s.fat;
    (tf.elements.namedItem("fiber_g") as HTMLInputElement).value = s.fiber;
  });
  tf.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = Object.fromEntries(new FormData(tf));
    const body = { op: "objetivos", student_id: studentId, ...fd, confirm_deficit: Boolean(fd.confirm_deficit) };
    for (const k of Object.keys(body) as (keyof typeof body)[]) if ((body as Record<string, unknown>)[k] === "") delete (body as Record<string, unknown>)[k];
    const r = await fetch("/api/coach/meals", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) }).then((x) => x.json() as Promise<{ ok: boolean; errors?: Record<string, string> }>);
    document.getElementById("t-err")!.textContent = r.ok ? "" : Object.values(r.errors ?? {})[0] ?? "No se pudo.";
    if (r.ok) {
      targets = { kcal: Number(fd.kcal), protein_g: Number(fd.protein_g), carbs_g: Number(fd.carbs_g), fat_g: Number(fd.fat_g) };
      totals();
    }
  });

  // save / publish
  const err = document.getElementById("err")!;
  const conflictsEl = document.getElementById("conflicts")!;
  const save = async () => {
    const body = {
      op: "guardar",
      student_id: studentId,
      kind: (document.getElementById("kind") as unknown as HTMLSelectElement).value,
      change_reason: (document.getElementById("reason") as unknown as HTMLInputElement).value || undefined,
      meals: state.meals.map((m) => ({ slot: m.slot, day_type: m.day_type, items: m.items.map((i) => ({ kind: i.kind, id: i.id, grams: i.grams, household_measure: i.household_measure })) })),
    };
    const r = await fetch("/api/coach/meals", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) }).then((x) => x.json() as Promise<{ ok: boolean; conflicts?: { name: string; detail: string }[]; errors?: Record<string, string> }>);
    if (!r.ok) {
      err.textContent = Object.values(r.errors ?? {})[0] ?? "No se pudo guardar.";
      return false;
    }
    conflictsEl.innerHTML = (r.conflicts ?? []).map((c) => `<li>${esc(c.name)}: conflicto con ${esc(c.detail)}</li>`).join("");
    return (r.conflicts ?? []).length === 0;
  };
  document.getElementById("save")!.addEventListener("click", async () => {
    err.textContent = "";
    if (await save()) err.textContent = "";
    const n = document.getElementById("save")!;
    n.textContent = "Borrador guardado";
    setTimeout(() => (n.textContent = "Guardar borrador"), 1600);
  });
  document.getElementById("publish")!.addEventListener("click", async () => {
    err.textContent = "";
    if (!(await save())) {
      if (!err.textContent) err.textContent = "Corrige los conflictos marcados antes de publicar.";
      return;
    }
    const r = await fetch("/api/coach/meals", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ op: "publicar", student_id: studentId }) }).then((x) => x.json() as Promise<{ ok: boolean; errors?: Record<string, string> }>);
    if (r.ok) location.assign(`/coach/estudiantes/${studentId}?tab=alimentacion`);
    else err.textContent = Object.values(r.errors ?? {})[0] ?? "No se pudo publicar.";
  });
  render();
</script>
