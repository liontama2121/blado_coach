</style>

<script>
  const id = location.pathname.split("/").filter(Boolean).at(-1)!;
  const api = async (body: Record<string, unknown>) => {
    const res = await fetch("/api/coach/students", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ id, ...body }) }).catch(() => null);
    return res ? ((await res.json()) as { ok: boolean; errors?: Record<string, string>; tempPassword?: string; planUnpublished?: boolean }) : { ok: false, errors: { form: "Sin conexión." } };
  };
  const showErrs = (scope: HTMLElement, errs: Record<string, string>) => {
    scope.querySelectorAll<HTMLElement>("[data-e]").forEach((e) => (e.textContent = ""));
    for (const [k, msg] of Object.entries(errs)) {
      const key = k.split(".").at(-1)!;
      const el = scope.querySelector<HTMLElement>(`[data-e="${key}"]`) ?? scope.querySelector<HTMLElement>('[data-e="form"]');
      if (el) el.textContent = msg;
    }
  };

  document.querySelectorAll<HTMLFormElement>("form[data-op]").forEach((form) =>
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const op = form.dataset.op!;
      const fd = new FormData(form);
      const data: Record<string, unknown> = {};
      if (op === "salud") {
        data.parq = [0, 1, 2, 3, 4, 5, 6].map((i) => Number(fd.get(`parq.${i}`) ?? 0));
        for (const k of ["injuries", "surgeries", "conditions", "medications"]) data[k] = fd.get(k);
      } else {
        for (const [k, v] of fd.entries()) {
          if (k === "home_equipment") ((data.home_equipment ??= []) as unknown[]).push(v);
          else data[k] = v;
        }
        if (op === "objetivo") {
          data.home_equipment ??= [];
          data.smoker = fd.get("smoker") ? 1 : 0;
        }
      }
      const btn = form.querySelector<HTMLButtonElement>("button:not([type=button])");
      if (btn) btn.disabled = true;
      const r = await api({ op, data });
      if (btn) btn.disabled = false;
      if (r.ok) {
        if (r.planUnpublished) alertBox(form, "Ojo: un plan de alimentación volvió a borrador porque ya no es seguro con esta restricción.");
        else location.reload();
      } else showErrs(form, r.errors ?? {});
    }),
  );
  const alertBox = (form: HTMLElement, msg: string) => {
    const el = form.querySelector<HTMLElement>('[data-e="form"]');
    if (el) el.textContent = msg;
    setTimeout(() => location.reload(), 2500);
  };

  document.querySelectorAll<HTMLButtonElement>("[data-rm]").forEach((b) =>
    b.addEventListener("click", async () => {
      b.disabled = true;
      const r = await api({ op: "quitar_restriccion", restriction_id: b.dataset.rm });
      if (r.ok) location.reload();
    }),
  );

  document.querySelectorAll<HTMLButtonElement>("button[data-act]").forEach((b) =>
    b.addEventListener("click", async () => {
      const act = b.dataset.act!;
      const scope = b.closest("section")!;
      b.disabled = true;
      const body: Record<string, unknown> =
        act === "estado" ? { op: "estado", status: b.dataset.status } : act === "eliminar" ? { op: "eliminar", confirm: (document.getElementById("del-confirm") as unknown as HTMLInputElement).value } : { op: "clave" };
      const r = await api(body);
      b.disabled = false;
      if (!r.ok) {
        const el = scope.querySelector<HTMLElement>("[data-e]");
        if (el) el.textContent = Object.values(r.errors ?? {})[0] ?? "No se pudo.";
        return;
      }
      if (act === "eliminar") location.assign("/coach/estudiantes");
      else if (act === "clave") {
        const c = document.getElementById("cred")!;
        c.hidden = false;
        c.textContent = `Nueva clave temporal: ${r.tempPassword} (se muestra solo esta vez)`;
      } else location.reload();
    }),
  );
</script>
