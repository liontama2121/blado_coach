  }
  .kpis b {
    font: 400 2.8rem/0.9 var(--disp);
    font-variation-settings: "wdth" 75;
    font-variant-numeric: tabular-nums;
  }
  .kpis small {
    font-size: 1rem;
    color: var(--mute);
  }
  .dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 16px;
    margin: 0;
    font-size: 14px;
  }
  .dl dt {
    color: var(--mute);
  }
  .dl dd {
    margin: 0;
  }
  .plan-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }
  .rx {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .rx li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--card2);
  }
  .rx li .c-btn {
    margin-left: auto;
    min-height: 34px;
  }
  .parq {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 10px;
    font-size: 14px;
  }
  .parq li {
    display: flex;
    flex-wrap: wrap;
