---
// Coach dashboard: KPIs, prioritized alerts, today, pending proposals.
export const prerender = false;
import { env } from "cloudflare:workers";
import CoachShell from "@/layouts/CoachShell.astro";
import Bladimir from "@/components/mascota/Bladimir.astro";
import Icon from "@/components/Icon.astro";
import { formatDate } from "@/config/site";
import { bogotaParts, formatMinute } from "@/lib/schedule";
import { alertsFor, listStudents } from "@/lib/server/coach";

const now = new Date();
const { date: today, minute } = bogotaParts(now);
const [students, pending, upcoming, adherence] = await Promise.all([
  listStudents(env.DB),
  env.DB.prepare(`SELECT COUNT(*) AS n FROM training_sessions WHERE status = 'solicitada' AND counter_starts_at IS NULL AND starts_at > ?1`).bind(now.toISOString()).first<{ n: number }>(),
  env.DB.prepare(
    `SELECT t.starts_at, t.location, t.meet_url, s.full_name, s.id AS sid FROM training_sessions t JOIN students s ON s.id = t.student_id
      WHERE t.status = 'confirmada' AND t.ends_at > ?1 ORDER BY t.starts_at LIMIT 6`,
  )
    .bind(now.toISOString())
    .all<{ starts_at: string; location: string; meet_url: string | null; full_name: string; sid: string }>(),
  env.DB.prepare(`SELECT AVG(nutrition_adherence) AS food, AVG(CAST(sessions_done AS REAL) / NULLIF(sessions_planned, 0)) AS train FROM weekly_checkins WHERE week_start >= date(?1, '-14 day')`)
    .bind(today)
    .first<{ food: number | null; train: number | null }>(),
]);
const active = students.filter((s) => s.status === "activo");
const alerts = active.flatMap((s) => alertsFor(s, today).map((t) => ({ s, t })));
const hello = minute < 720 ? "Buenos días" : minute < 1140 ? "Buenas tardes" : "Buenas noches";
const when = (iso: string) => {
  const p = bogotaParts(new Date(iso));
  return `${p.date === today ? "Hoy" : formatDate(p.date)} · ${formatMinute(p.minute)}`;
};
---

<CoachShell title="Inicio" section="inicio">
  <section class="c-card dash-hero">
    <Bladimir state="wave" size={96} />
    <div class="grid gap-2">
      <h1 class="c-h1">{hello}, coach</h1>
      <p class="c-muted">{pending?.n ? `Tienes ${pending.n} propuesta${pending.n > 1 ? "s" : ""} de horario por responder.` : "Todo al día con las sesiones."}</p>
    </div>
    <a href="/coach/estudiantes/nuevo" class="c-btn"><Icon name="plus" size={18} /> Nuevo estudiante</a>
  </section>

  <section class="kpis" aria-label="Resumen">
    <div class="c-card"><span class="c-muted">Estudiantes activos</span><b>{active.length}</b></div>
    <a class="c-card" href="/coach/sesiones"><span class="c-muted">Propuestas por responder</span><b class:list={[pending?.n && "lime"]}>{pending?.n ?? 0}</b></a>
    <div class="c-card"><span class="c-muted">Adherencia a entrenos (14 días)</span><b>{adherence?.train != null ? `${Math.round(adherence.train * 100)} %` : "-"}</b></div>
    <div class="c-card"><span class="c-muted">Adherencia a la comida (14 días)</span><b>{adherence?.food != null ? `${Math.round(adherence.food * 10)} %` : "-"}</b></div>
  </section>

  <div class="two">
    <section class="c-card" aria-labelledby="al-t">
      <div class="c-row"><h2 id="al-t" class="c-h2">Alertas</h2><span class="c-tag">{alerts.length}</span></div>
      {
        alerts.length === 0 ? (
          <p class="c-muted">Nada pendiente. Buen trabajo.</p>
        ) : (
          <ul class="list">
            {alerts.map((a) => (
              <li>
                <a href={`/coach/estudiantes/${a.s.id}`}>{a.s.full_name}</a>
                <span class:list={["c-tag", a.t.startsWith("PAR-Q") ? "c-tag-err" : "c-tag-warn"]}>{a.t}</span>
              </li>
            ))}
          </ul>
        )
      }
    </section>
    <section class="c-card" aria-labelledby="up-t">
      <div class="c-row"><h2 id="up-t" class="c-h2">Próximas sesiones</h2><a href="/coach/sesiones" class="c-tag">Ver todas</a></div>
      {
        upcoming.results.length === 0 ? (
          <p class="c-muted">Sin sesiones confirmadas.</p>
        ) : (
          <ul class="list">
            {upcoming.results.map((u) => (
              <li>
                <div class="grid">
                  <a href={`/coach/estudiantes/${u.sid}`}>{u.full_name}</a>
                  <span class="c-muted text-sm tnum">{when(u.starts_at)}</span>
                </div>
                {u.location === "casa" && u.meet_url ? (
                  <a class="c-tag c-tag-ok" href={u.meet_url} target="_blank" rel="noopener">Meet</a>
                ) : (
                  <span class="c-tag">{u.location === "casa" ? "Virtual" : "Gimnasio"}</span>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</CoachShell>

<style>
  .dash-hero {
    grid-template-columns: auto 1fr auto;
    align-items: center;
  }
  @media (max-width: 700px) {
    .dash-hero {
      grid-template-columns: auto 1fr;
    }
    .dash-hero .c-btn {
      grid-column: 1 / -1;
    }
  }
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .kpis .c-card {
    text-decoration: none;
    color: inherit;
  }
  .kpis b {
    font: 400 3rem/0.9 var(--disp);
    font-variation-settings: "wdth" 75;
    font-variant-numeric: tabular-nums;
  }
  .kpis b.lime {
    color: var(--lime);
  }
  @media (max-width: 900px) {
    .kpis {
      grid-template-columns: 1fr 1fr;
    }
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  @media (max-width: 900px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .list a {
    color: var(--fg);
    font-weight: 600;
    text-decoration: none;
  }
  .list a:hover {
    color: var(--lime);
  }
</style>
