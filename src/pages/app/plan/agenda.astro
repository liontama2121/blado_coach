---
// "Plan": my sessions + request a new one from the coach's free slots.
export const prerender = false;
import { env } from "cloudflare:workers";
import AppShell from "@/layouts/AppShell.astro";
import Bladimir from "@/components/mascota/Bladimir.astro";
import { formatDate } from "@/config/site";
import { bogotaParts, formatMinute } from "@/lib/schedule";
import { loadWeek } from "@/lib/server/agenda";
import { getSessions } from "@/lib/server/student";
import PlanTabs from "@/components/app/PlanTabs.astro";

const studentId = Astro.locals.user!.studentId!;
const now = new Date();
const [sessions, week] = await Promise.all([getSessions(env.DB, studentId, now.toISOString()), loadWeek(env.DB, now)]);
const DAYS = ["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"];
const WHERE = { gym: "Gym", casa: "Casa", ambos: "Casa o gym" } as const;
const freeDays = week.days.filter((d) => d.slots.some((s) => s.state === "free"));
---

<AppShell title="Agenda" tab="plan">
  <PlanTabs active="agenda" />

  <section class="card" aria-labelledby="ses-t">
    <h2 id="ses-t" class="app-h2">Mis sesiones</h2>
    {
      sessions.length === 0 ? (
        <div class="row">
          <p class="muted">Aún no tienes sesiones agendadas.</p>
          <Bladimir state="lift" size={84} />
        </div>
      ) : (
        <ul class="ses">
          {sessions.map((s) => {
            const p = bogotaParts(new Date(s.starts_at));
            return (
              <li class="row">
                <div>
                  <strong class="tnum">{DAYS[new Date(`${p.date}T12:00:00Z`).getUTCDay()]} {formatDate(p.date)} · {formatMinute(p.minute)}</strong>
                  <p class="muted text-sm">{s.location === "casa" ? "En casa" : "En gimnasio"}</p>
                </div>
                <span class:list={["tag", s.status === "confirmada" ? "tag-ok" : "tag-wait"]}>{s.status === "confirmada" ? "Confirmada" : "Por confirmar"}</span>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  <section class="card" aria-labelledby="req-t">
    <div class="row">
      <h2 id="req-t" class="app-h2">Pedir sesión</h2>
      <Bladimir state="point" size={70} dir="left" />
    </div>
    <p class="muted text-sm">Elige un horario libre y dónde quieres entrenar. El coach lo confirma.</p>
    <form id="req-form" class="grid gap-4">
      <fieldset class="grid gap-2">
        <legend class="mb-2 text-sm font-semibold">Dónde</legend>
        <div class="seg">
          <label><input type="radio" name="location" value="casa" checked /><span>En casa</span></label>
          <label><input type="radio" name="location" value="gym" /><span>En gimnasio</span></label>
        </div>
      </fieldset>
      <div class="days" role="radiogroup" aria-label="Horarios libres">
        {
          freeDays.length === 0 ? (
            <p class="muted">No hay horarios libres esta semana. Escríbele al coach.</p>
          ) : (
            freeDays.map((d) => (
              <div class="day">
                <p class="day-h">{d.date === week.today ? "Hoy" : DAYS[d.weekday]} <span class="muted">{formatDate(d.date).slice(0, 5)}</span></p>
                <div class="slots">
                  {d.slots
                    .filter((s) => s.state === "free")
                    .map((s) => (
                      <label class="slot" data-loc={s.location}>
                        <input type="radio" name="slot" value={`${d.date}|${s.start}`} required />
                        <span>{formatMinute(s.start)}<small>{WHERE[s.location]}</small></span>
                      </label>
                    ))}
                </div>
              </div>
            ))
          )
        }
      </div>
      <p class="text-sm" style="color:var(--err)" data-req-err role="alert"></p>
      <button type="submit" class="pill-btn" data-req-btn>Pedir este horario</button>
    </form>
  </section>
</AppShell>

<style>
  .ses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .ses li + li {
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .seg label span,
  .slot span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .seg input,
  .slot input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .seg input:checked + span,
  .slot input:checked + span {
    background: var(--lime);
    border-color: var(--lime);
    color: #0d0d0d;
  }
  .seg input:focus-visible + span,
  .slot input:focus-visible + span {
    outline: 2px solid var(--lime);
    outline-offset: 2px;
  }
  .slot small {
    font-weight: 500;
    font-size: 11px;
    opacity: 0.7;
  }
  .slot[hidden] {
    display: none;
  }
  .days {
    display: grid;
    gap: 14px;
  }
  .day-h {
    margin: 0 0 8px;
    font-weight: 600;
  }
  .slots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 8px;
  }
</style>

<script>
  const form = document.getElementById("req-form") as HTMLFormElement | null;
  if (form) {
    const err = form.querySelector<HTMLElement>("[data-req-err]")!;
    const btn = form.querySelector<HTMLButtonElement>("[data-req-btn]")!;
    // Only show slots that allow the chosen place.
    const filter = () => {
      const loc = (form.querySelector<HTMLInputElement>('input[name="location"]:checked')?.value ?? "casa") as string;
      form.querySelectorAll<HTMLElement>(".slot").forEach((s) => {
        const ok = s.dataset.loc === "ambos" || s.dataset.loc === loc;
        s.hidden = !ok;
        if (!ok) (s.querySelector("input") as HTMLInputElement).checked = false;
      });
    };
    form.querySelectorAll('input[name="location"]').forEach((r) => r.addEventListener("change", filter));
    filter();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const slot = String(fd.get("slot") ?? "");
      if (!slot) {
        err.textContent = "Elige un horario.";
        return;
      }
      const [date, start] = slot.split("|");
      btn.disabled = true;
      err.textContent = "";
      const res = await fetch("/api/app/sessions", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ date, start: Number(start), location: fd.get("location") }),
      }).catch(() => null);
      const data = res ? ((await res.json()) as { ok: boolean; error?: string }) : { ok: false, error: "Sin conexión." };
      if (data.ok) location.reload();
      else {
        err.textContent = data.error ?? "No se pudo pedir la sesión.";
        btn.disabled = false;
      }
    });
  }
</script>
