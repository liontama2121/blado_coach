---
// Placeholder for Fase 1. The real landing (Negro Lima) is built in Fase 2.
export const prerender = true;
import Base from "@/layouts/Base.astro";
import { site } from "@/config/site";
---

<Base title={`${site.brand} · Entrenamiento personal en ${site.city}`} description="Entrenamiento personal en casa y en gimnasio en Bogotá.">
  <main class="min-h-[100dvh] grid place-content-center gap-6 px-4">
    <h1 class="font-display font-black uppercase leading-[0.84] text-[clamp(64px,14vw,180px)]">
      Entrena con <em class="text-lime">intención.</em>
    </h1>
    <p class="text-mute-2">Landing en construcción.</p>
  </main>
</Base>
