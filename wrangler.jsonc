{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coach",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // main / assets are filled in by @astrojs/cloudflare at build time (dist/server/wrangler.json).
  "observability": { "enabled": true },

  // Base de datos principal. Crear con: npx wrangler d1 create blado-db
  // y pegar aquí el database_id que devuelve el comando.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blado-db",
      "database_id": "f5f83e1c-b9d4-49e7-939d-0ad4ebfe3eca",
      "migrations_dir": "db/migrations"
    }
  ],

  // Bucket PRIVADO para fotos de progreso y autorizaciones médicas.
  // Crear con: npx wrangler r2 bucket create blado-private
  // Nunca habilitar acceso público (r2.dev ni dominio propio) en este bucket.
  // Pendiente: R2 aún no está activado en la cuenta (Dashboard → R2). Descomentar en la Fase 5.
  // "r2_buckets": [
  //   { "binding": "PRIVATE_FILES", "bucket_name": "blado-private" }
  // ],

  "vars": {
    "SESSION_TTL_DAYS": "14",
    "TRAVEL_BUFFER_MIN": "0"
  }
  // Secretos (no van aquí): `npx wrangler secret put FILE_URL_SECRET`
  // En local se ponen en .dev.vars (ver .dev.vars.example).
}
